#!/usr/bin/env bash
# dana — control CLI for the Dana app.
#
# A thin wrapper over `docker compose` so you can run `dana start|stop|restart|status|
# logs|update|install` from anywhere. The containers themselves are booted by
# entrypoint.sh (the image CMD); this script just drives their lifecycle from the host.
set -euo pipefail

# Resolve the repo directory even when `dana` is invoked through a symlink on PATH.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
DANA_DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"

PORT="${PORT:-3000}"

dc() { (cd "$DANA_DIR" && docker compose "$@"); }

# localfirecrawl (opt-in, heavy) — driven from its thin wrapper compose, which
# `include:`s the upstream stack from the clone at firecrawl/localfirecrawl/.
FIRECRAWL_DIR="$DANA_DIR/firecrawl"
fc() { (cd "$DANA_DIR" && docker compose -f "$FIRECRAWL_DIR/docker-compose.yml" "$@"); }

firecrawl() {
  local clone="$FIRECRAWL_DIR/localfirecrawl"
  if [ ! -d "$clone/.git" ]; then
    echo "Cloning localfirecrawl into $clone …"
    git clone https://github.com/teelaitila/localfirecrawl "$clone"
  fi
  # localfirecrawl reads its config (incl. PORT=3002) from its own .env; seed it
  # from .env.example on first run, generating a SearXNG secret if openssl is here.
  if [ ! -f "$clone/.env" ] && [ -f "$clone/.env.example" ]; then
    echo "Seeding $clone/.env from .env.example (PORT=3002) …"
    cp "$clone/.env.example" "$clone/.env"
    if command -v openssl >/dev/null 2>&1; then
      local secret; secret="$(openssl rand -hex 32)"
      sed -i "s/^SEARXNG_SECRET_KEY=.*/SEARXNG_SECRET_KEY=$secret/" "$clone/.env" 2>/dev/null || true
    fi
  fi
  echo "Building + starting localfirecrawl (Firecrawl api → http://localhost:3002). First build is SLOW…"
  fc up -d --build "$@"
  echo "localfirecrawl → http://localhost:3002   (\`dana firecrawl-logs\` to watch · \`dana firecrawl-stop\` to stop)"
  echo "Dana uses it automatically via FIRECRAWL_URL=http://host.docker.internal:3002."
}

# Opt-in cutover: run the Python (FastAPI/DSPy) backend AS the served app on :3001,
# serving the built React SPA itself (FRONTEND_DIST). Gated behind the compose
# `pyserve` profile so the default stack is untouched. See server-py/docs/CUTOVER.md.
PYSERVE_PORT="${PYSERVE_PORT:-3001}"

pyserve() {
  local dist="$DANA_DIR/app/frontend/dist"
  # The compose service bind-mounts app/frontend/dist read-only into the container.
  # Build the SPA if it's missing so server-py has something to serve.
  if [ ! -f "$dist/index.html" ]; then
    command -v bun >/dev/null 2>&1 || {
      echo "app/frontend/dist is missing and bun is not installed to build it." >&2
      echo "Install bun (https://bun.sh) or build the SPA yourself into $dist." >&2
      exit 1
    }
    echo "Building the SPA into app/frontend/dist (one-time; needed for pyserve)…"
    ( cd "$DANA_DIR/app/frontend" && bun install >/dev/null 2>&1 && bun run build )
  else
    echo "Using existing built SPA at app/frontend/dist."
  fi
  echo "Building + starting the Python backend (server-py) on :$PYSERVE_PORT (serving the SPA)…"
  dc --profile pyserve up -d --build server-py "$@"
  echo "server-py → http://localhost:$PYSERVE_PORT   (\`dana logs server-py\` to watch · \`dana pyserve-stop\` to stop)"
  echo "It serves the React SPA via FRONTEND_DIST and the /api + /stream contract from Python."
}

usage() {
  cat <<EOF
dana — control the Dana app  (http://localhost:$PORT)

Usage: dana <command> [args]

Lifecycle (Docker):
  install        Build the image(s)                     (docker compose build)
  start          Start app + web search in background   (docker compose up -d)
  stop           Stop and remove containers             (docker compose down)
  restart        Restart running services               (docker compose restart)
  update         git pull, rebuild, restart
  status         Show service status                    (docker compose ps)
  logs [svc]     Follow logs (optionally one service)   (docker compose logs -f)
  shell          Open a shell inside the app container

Python backend AS the served app (opt-in cutover — see server-py/docs/CUTOVER.md):
  pyserve        Build the SPA (if missing) + run server-py serving it on :3001
  pyserve-stop   Stop the server-py service (leaves the rest of the stack up)

Playwright-grade fetch (opt-in, no API key — HEAVY build-from-source):
  firecrawl      Clone+build+start localfirecrawl (Firecrawl api on :3002)
  firecrawl-stop Stop and remove the localfirecrawl stack
  firecrawl-logs Follow localfirecrawl logs (watch the slow first build)

Local development (needs Bun + a proxy on :8317):
  dev            Run backend (:$PORT) + frontend dev server (:5173)
  test           Run no-network unit tests (server-py pytest + backend bun test)

Setup:
  link           Symlink \`dana\` onto your PATH (run it from anywhere)
  help           Show this help
EOF
}

dev() {
  command -v bun >/dev/null 2>&1 || { echo "bun is not installed — see https://bun.sh" >&2; exit 1; }
  echo "Bringing up SearXNG (web search) via compose…"
  dc up -d searxng >/dev/null 2>&1 || echo "  (skipped — start SearXNG yourself if search fails)"
  echo "Starting backend (:$PORT) + frontend dev server (:5173). Needs CLIProxyAPI on :8317."
  ( cd "$DANA_DIR/app/backend" && bun install >/dev/null 2>&1 && PORT="$PORT" bun run --watch src/index.ts ) &
  local back=$!
  ( cd "$DANA_DIR/app/frontend" && bun install >/dev/null 2>&1 && bun run dev ) &
  local front=$!
  trap 'kill "$back" "$front" 2>/dev/null || true' INT TERM
  wait
}

# Pure-logic unit tests — NO network, NO LLM, NO secrets. Runs the server-py pytest suite
# (test_*.py) and the backend bun tests under app/backend/src/. Used locally and in CI.
test() {
  local rc=0
  echo "== server-py: pytest (no-network unit tests) =="
  if command -v uv >/dev/null 2>&1; then
    ( cd "$DANA_DIR/server-py" && uv run --extra dev --extra dspy pytest -q ) || rc=1
  elif [ -x "$DANA_DIR/server-py/.venv/bin/python" ]; then
    ( cd "$DANA_DIR/server-py" && .venv/bin/python -m pytest -q ) || rc=1
  else
    echo "  (skipped — neither uv nor server-py/.venv found)"; rc=1
  fi

  echo
  echo "== app/backend: bun test (no-network unit tests under src/) =="
  if command -v bun >/dev/null 2>&1; then
    ( cd "$DANA_DIR/app/backend" && bun install >/dev/null 2>&1 && bun test src/ ) || rc=1
  else
    echo "  (skipped — bun is not installed — see https://bun.sh)"; rc=1
  fi

  return "$rc"
}

link() {
  local target="$DANA_DIR/dana" d
  for d in "$HOME/.local/bin" /usr/local/bin; do
    if [ -d "$d" ] && case ":$PATH:" in *":$d:"*) true ;; *) false ;; esac; then
      if ln -sf "$target" "$d/dana" 2>/dev/null; then echo "Linked → $d/dana"; return; fi
    fi
  done
  mkdir -p "$HOME/.local/bin" && ln -sf "$target" "$HOME/.local/bin/dana"
  echo "Linked → $HOME/.local/bin/dana"
  echo "Add it to PATH if needed:  export PATH=\"\$HOME/.local/bin:\$PATH\""
}

cmd="${1:-help}"; shift 2>/dev/null || true
case "$cmd" in
  install|build)  dc build "$@" ;;
  start|up)       dc up -d "$@"; echo "Dana → http://localhost:$PORT   (\`dana status\` to check · \`dana logs\` to watch)" ;;
  stop|down)      dc down "$@" ;;
  restart)        dc restart "$@"; echo "Restarted → http://localhost:$PORT" ;;
  status|ps)      dc ps "$@" ;;
  logs)           dc logs -f "$@" ;;
  shell|sh)       dc exec dana sh ;;
  pyserve)           pyserve "$@" ;;
  pyserve-stop)      dc --profile pyserve stop server-py "$@" ;;
  firecrawl)         firecrawl "$@" ;;
  firecrawl-stop)    fc down "$@" ;;
  firecrawl-logs)    fc logs -f "$@" ;;
  update)         ( cd "$DANA_DIR" && git pull --ff-only ) && dc build && dc up -d && echo "Updated → http://localhost:$PORT" ;;
  dev)            dev ;;
  test)           test "$@" ;;
  link)           link ;;
  help|-h|--help) usage ;;
  *)              echo "dana: unknown command '$cmd'" >&2; echo; usage; exit 1 ;;
esac
